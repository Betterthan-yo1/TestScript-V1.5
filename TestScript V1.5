-- Main Menu Frame (Wider)
local menuWidth, menuHeight = 400, 500  -- Adjusted for simpler menu
local screenWidth, screenHeight = workspace.CurrentCamera.ViewportSize.X, workspace.CurrentCamera.ViewportSize.Y  -- Get screen size

local scrollFrame = Instance.new("ScrollingFrame", screenGui)
scrollFrame.Size = UDim2.new(0, menuWidth, 0, menuHeight)
scrollFrame.Position = UDim2.new(0, (screenWidth - menuWidth) / 2, 0, (screenHeight - menuHeight) / 2)
scrollFrame.CanvasSize = UDim2.new(0, 0, 0, 600)
scrollFrame.BackgroundColor3 = Color3.new(0.15, 0.15, 0.15)
scrollFrame.Name = "MainMenu"
scrollFrame.ScrollBarThickness = 10

local yOffset = 0

-- Button creation helper with padding between buttons
local function createButton(name, callback)
    local button = Instance.new("TextButton", scrollFrame)
    button.Size = UDim2.new(1, -10, 0, 40)
    button.Position = UDim2.new(0, 5, 0, yOffset)
    button.BackgroundColor3 = Color3.new(0.2, 0.6, 1)
    button.Text = name
    button.TextScaled = true
    button.TextColor3 = Color3.new(1, 1, 1)
    button.BorderSizePixel = 0
    button.MouseButton1Click:Connect(callback)
    yOffset = yOffset + 45
    scrollFrame.CanvasSize = UDim2.new(0, 0, 0, yOffset + 50)
end

